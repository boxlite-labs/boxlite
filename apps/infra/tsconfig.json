{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "customConditions": ["development"]
  },
  "ts-node": {
    "esm": true,
    "experimentalResolver": true,
    "transpileOnly": true
  },
  "include": [
    "sst.config.ts",
    "artifacts/**/*.ts",
    "auth0/**/*.ts",
    "bootstrap/**/*.ts",
    "deployment/**/*.ts",
    "policies/**/*.ts",
    "runner/**/*.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "stack/**/*.ts"
  ]
}
